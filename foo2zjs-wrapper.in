#!/bin/sh

#* Copyright (C) 2003-2006  Rick Richardson
#* Dedicated CP1025/CP1025nw edition (2026)
#* Licensed under GNU GPL v2 or later.

VERSION='$Id: foo2zjs-wrapper-cp1025,v 2026.11.25 Exp $'

PROGNAME="$0"
BASENAME=`basename "$PROGNAME"`
PREFIX=/usr
SHARE="$PREFIX/share/foo2zjs"
PATH="$PREFIX/bin:$PATH"

if [ -x /usr/bin/logger -o -x /bin/logger ]; then
    logger -t "$BASENAME" -p lpr.info -- "$BASENAME $@" </dev/null
fi

usage() {
	cat <<EOF
Usage:
	$BASENAME [options] [ps-file]

	Foomatic printer wrapper for HP LaserJet Pro CP1025/CP1025nw (foo2zjs).

Options:
-c                Print in color (else monochrome)
-C colormode      Colormode [10=ICM Pure-K Neutral GCR]
-d duplex         Duplex code: 1=off, 4=manual longedge, 5=manual shortedge [$DUPLEX]
-m media          Media code [$MEDIA]
-p paper          Paper code [$PAPER] (9=A4, 1=Letter, 5=Legal, 11=A5, 268=4x6, 270=10x15, ...)
-n copies         Number of copies [$COPIES]
-r <xres>x<yres>  Resolution: 600x600 or 1200x600 [$RES]
-s source         Source code [$SOURCE]
-t                Draft mode (EconoMode)
-T density        Print density (1-5) [$DENSITY]
-u <xoff>x<yoff>  Upper left clipping offset
-l <xoff>x<yoff>  Lower right clipping offset
-L mask           Logical clip mask [0]
-P                Do not output START_PLANE codes
-X padlen         Extra BID zero padding [16]
-z model          Model [3=CP1025nw]
-D lvl            Debug level [$DEBUG]
-V                $VERSION
EOF
	exit 1
}

error() {
	echo "$BASENAME: $1" >&2
	exit 1
}

nup() {
    case "$NUP" in
    [2368]|1[0458])
	tr '\r' '\n' | psnup $NUP_ORIENT -d2 -$NUP -m.3in -p$paper -q
	;;
    [49]|1[26])
	tr '\r' '\n' | psnup $NUP_ORIENT -d2 -$NUP -m.5in -p$paper -q
	;;
    *)
	error "Illegal call to nup()."
	;;
    esac
}

GSBIN=${GSBIN:-gs}
GSVER=`$GSBIN --version`

CMDLINE="$*"
DEBUG=0
DUPLEX=1
COLOR=
COLORMODE=10
MODEL=3
QUALITY=micro
MEDIA=1
COPIES=1
PAPER=9
RES=1200x600
SOURCE=7
NUP=
CLIP_UL=
CLIP_LR=
CLIP_LOG=
BC=
AIB=
NOPLANES=
COLOR2MONO=
GAMMAFILE=none
INTENT=0
GSOPTS=
EXTRAPAD=
SAVETONER=
DENSITY=3
NUP_ORIENT=
TMPFILE=

while getopts "1:23456789o:b:cC:d:g:l:u:L:m:n:p:q:r:s:tT:z:ABS:D:G:I:PX:Vh?" opt
do
	case $opt in
	b)	GSBIN="$OPTARG";;
	c)	COLOR=-c;;
	d)	DUPLEX="$OPTARG";;
	g)	GSOPTS="$GSOPTS $OPTARG";;
	m)	MEDIA="$OPTARG";;
	n)	COPIES="$OPTARG";;
	p)	PAPER="$OPTARG";;
	q)	QUALITY="$OPTARG";;
	r)	RES="$OPTARG";;
	s)	SOURCE="$OPTARG";;
	t)	SAVETONER="-t";;
	T)	DENSITY="$OPTARG";;
	z)	MODEL="$OPTARG";;
	l)	CLIP_LR="-l $OPTARG";;
	u)	CLIP_UL="-u $OPTARG";;
	L)	CLIP_LOG="-L $OPTARG";;
	A)	;;
	B)	;;
	C)	COLORMODE="$OPTARG";;
	S)	COLOR2MONO="-S$OPTARG";;
	D)	DEBUG="$OPTARG";;
	G)	GAMMAFILE="$OPTARG";;
	I)	INTENT="$OPTARG";;
	P)	NOPLANES=-P;;
	X)	EXTRAPAD="-X $OPTARG";;
	[234689])	NUP="$opt";;
	[57])	error "Can't find acceptable layout for $opt-up";;
	1)	case "$OPTARG" in
		[024568])	NUP="1$OPTARG";;
		*)	error "Can't find acceptable layout for 1$OPTARG-up";;
		esac
		;;
	o)	case "$OPTARG" in
		l*)	NUP_ORIENT=-l;;
		s*)	NUP_ORIENT=-r;;
		p*|*)	NUP_ORIENT=;;
		esac;;
	V)	echo "$VERSION"; foo2zjs -V; foo2zjs-pstops -V; exit 0;;
	h|\?)
		if [ "$CMDLINE" != "-?" -a "$CMDLINE" != -h ]; then
		    echo "Illegal command:"
		    echo "	$0 $CMDLINE"
		    echo
		fi
		usage;;
	esac
done
shift `expr $OPTIND - 1`

if [ $# -ge 1 ]; then
    exec < "$1"
fi

case "$MODEL" in
0|1|2|3)	;;
*)	error "Unknown model code $MODEL";;
esac

case "$MEDIA" in
1|standard|plain)		MEDIA=1;;
2|transparency)			MEDIA=2;;
3|glossy)			MEDIA=3;;
257|envelope)			MEDIA=257;;
258|light)			MEDIA=258;;
259|letterhead)			MEDIA=259;;
261|thickstock|cardstock)	MEDIA=261;;
262|postcard|heavy)		MEDIA=262;;
263|labels|rough)		MEDIA=263;;
265|labels)			MEDIA=265;;
267|envelope)			MEDIA=267;;
273|vellum)			MEDIA=267;;
512|color)			MEDIA=512;;
513|letterhead)			MEDIA=513;;
514|preprinted)			MEDIA=514;;
515|prepunched)			MEDIA=515;;
516|recycled)			MEDIA=516;;
[0-9]*)				;;
*)				error "Unknown media code $MEDIA";;
esac

case "$SOURCE" in
1|upper)	SOURCE=1;;
2|lower)	SOURCE=2;;
4|manual)	SOURCE=4;;
7|auto)		SOURCE=7;;
[0-9]*)		;;
*)		error "Unknown source code $SOURCE";;
esac

case "$DUPLEX" in
1|off|none)	DUPLEX=1;;
2|long*)	DUPLEX=2;;
3|short*)	DUPLEX=3;;
[0-9]*)		;;
*)		error "Unknown duplex code $DUPLEX";;
esac

case "$RES" in
600x600|1200x600)	;;
*)		error "Illegal resolution $RES";;
esac

case "$DENSITY" in
1|2|3|4|5)	;;
*)		error "Illegal print density (-T) $DENSITY";;
esac

set_clipping() {
    ulx=$1; uly=$2
    lrx=$3; lry=$4

    if [ "$CLIP_UL" = "" ]; then
	if [ "$RES" = "600x600" ]; then
	    ulx=`expr $ulx / 2`
	fi
	CLIP_UL="-u ${ulx}x${uly}"
    fi
    if [ "$CLIP_LR" = "" ]; then
	if [ "$RES" = "600x600" ]; then
	    lrx=`expr $lrx / 2`
	fi
	CLIP_LR="-l ${lrx}x${lry}"
    fi
}

case "$PAPER" in
Custom*x*)
		XDIM=`echo "$PAPER" | sed -e "s/Custom.//" -e "s/x.*//" `
		YDIM=`echo "$PAPER" | sed -e "s/.*x//" `
		if [ "$XDIM" = "" -o "$YDIM" = "" ]; then
		    error "Custom page size '$PAPER' != 1-99999"
		fi
		if [ "$XDIM" -eq 0 -o "$YDIM" -eq 0 ]; then
		    error "Custom page size '$PAPER' != 1-99999"
		fi
		XDIM=`dc -e "$XDIM 1200* 72/p"`
		YDIM=`dc -e "$YDIM 600* 72/p"`
		PAPER=256;        paper=letter;
		MEDIA=261
		set_clipping 192 96 192 96
		;;
Custom*)
		if [ $DEBUG = 0 ]; then
		    TMPFILE=/tmp/cus$$
		else
		    TMPFILE=/tmp/custom.ps
		fi
		cat >$TMPFILE
		exec <$TMPFILE

		tmp=`head -n 10000 $TMPFILE \
		    | sed -n '/CustomPageSize/{n;p;n;p;}' \
		    | tr '\n' ' '`
		case "$tmp" in
		[0-9]*\ [0-9]*)
		    XDIM=`echo "$tmp" | sed 's/ .*//'`
		    YDIM=`echo "$tmp" | sed -e 's/^[^ ]* //' -e 's/ .*//'`
		    ;;
		*)
		    if [ $DEBUG = 0 ]; then rm -f $TMPFILE; fi
		    error "Custom page size [XY]DIM != 1-99999"
		    ;;
		esac
		XDIM=`dc -e "$XDIM 1200* 72/p"`
		YDIM=`dc -e "$YDIM 600* 72/p"`
		PAPER=256;        paper=letter;
		MEDIA=261
		set_clipping 192 96 192 96
		;;
1|letter)	PAPER=1;	paper=letter;    XDIM="10200"; YDIM="6600";  set_clipping 192 96 192 96;;
5|legal)	PAPER=5;	paper=legal;     XDIM="10200"; YDIM="8400";  set_clipping 192 96 192 96;;
7|executive)	PAPER=7;	paper=executive; XDIM="8700";  YDIM="6300";  set_clipping 192 96 192 96;;
9|a4|A4)	PAPER=9;	paper=a4;        XDIM="9920";  YDIM="7016";  set_clipping 192 96 192 96;;
11|a5|A5)	PAPER=11;	paper=a5;        XDIM="6992";  YDIM="4960";  set_clipping 192 96 192 96;;
13|b5|B5)	PAPER=13;	paper=b5;        XDIM="8598";  YDIM="6070";  set_clipping 192 96 192 96;;
20|"env#10")	PAPER=20;	paper=env10;     XDIM="4950";  YDIM="5700";  set_clipping 171 78 171 78;;
27|envDL)	PAPER=27;	paper=envDL;     XDIM="5200";  YDIM="5200";  set_clipping 176 84 176 84;;
28|envC5)	PAPER=28;	paper=envC5;     XDIM="7650";  YDIM="5408";  set_clipping 170 80 169 80;;
34|envB5)	PAPER=34;	paper=envB5;     XDIM="8316";  YDIM="5892";  set_clipping 174 74 174 74;;
37|envMonarch)	PAPER=37;	paper=envMonarch;XDIM="4650";  YDIM="4500";  set_clipping 174 78 173 78;;
70|262|A6)	PAPER=70;	paper=a6;        XDIM="4956";  YDIM="3498";  set_clipping 174 78 173 78;;
257|16k197x273) PAPER=257;      paper=executive; XDIM="9306";  YDIM="6448";  set_clipping 173 84 173 84;;
263|16k184x260) PAPER=263;      paper=executive; XDIM="8692";  YDIM="6142";  set_clipping 122 87 122 87;;
264|16k195x270) PAPER=264;      paper=executive; XDIM="9212";  YDIM="6378";  set_clipping 126 87 126 87;;
43|260|postcard) PAPER=43;      paper=executive; XDIM="4728";  YDIM="3498";  set_clipping 126 87 126 87;;
82|261|doublepostcardrotated)
		PAPER=82;       paper=executive; XDIM="6996";  YDIM="4722";  set_clipping 126 87 126 87;;
258|fanfoldgermanlegal)
		PAPER=258;      paper=legal;     XDIM="10200"; YDIM="7800";  set_clipping 192 96 192 96;;
268|photo4x6)	PAPER=268;      paper=a6;        XDIM="4800";  YDIM="3600";  set_clipping 192 96 192 96;;
269|photo5x8)	PAPER=269;      paper=statement; XDIM="6000";  YDIM="4800";  set_clipping 192 96 192 96;;
270|photo10x15)	PAPER=270;      paper=postcard;  XDIM="4818";  YDIM="3590";  set_clipping 192 96 192 96;;
*)		error "Unimplemented paper code $PAPER";;
esac

case "$RES" in
600x600)	XDIM=`expr $XDIM / 2`;;
1200x600)	;;
esac
DIM="${XDIM}x${YDIM}"

case $NUP in
[234689]|1[024568])	PREFILTER="nup";;
*)			PREFILTER=cat;;
esac
if [ "$DEBUG" -ge 9 ]; then
    PREFILTER="tee /tmp/$BASENAME.ps"
fi

if [ $DEBUG -gt 0 ]; then
    ICCTMP=/tmp/icc
else
    ICCTMP=/tmp/icc$$
fi

PSTOPS_OPTS="-n"
PUREK_ICC="$SHARE/crd/zjs/cp1025_purek_cmyk.icc"
USECIE_PS=""

if [ "" = "$COLOR" ]; then
    COLORMODE=
    GAMMAFILE=
else
    if [ "$GAMMAFILE" = "" -o "$GAMMAFILE" = default ]; then
	GAMMAFILE=none
    fi
    case "$GAMMAFILE" in
    none|none.icm|none.icc|*/none.icm)
	# Preserve native CMYK & DeviceGray, and separate sRGB neutral gray via Pure-K Neutral GCR ICC
	printf "%%!PS-Adobe-3.0\n<</UseCIEColor false>>setpagedevice\n" > "$ICCTMP.usecie.ps"
	USECIE_PS="$ICCTMP.usecie.ps"
	GAMMAFILE=""
	if [ -r "$PUREK_ICC" ]; then
	    case "$GSVER" in
	    9.*|10.*|[1-9][0-9].*)
		GSOPTS="$GSOPTS -sDefaultCMYKProfile=$PUREK_ICC -sOutputICCProfile=$PUREK_ICC"
		;;
	    esac
	fi
	;;
    *)
	if [ -r "$GAMMAFILE" ]; then
	    GAMMAFILE="-sOutputICCProfile=$GAMMAFILE -dRenderIntent=$INTENT"
	elif [ -r "$SHARE/icm/$GAMMAFILE" ]; then
	    GAMMAFILE="-sOutputICCProfile=$SHARE/icm/$GAMMAFILE -dRenderIntent=$INTENT"
	else
	    GAMMAFILE=""
	fi
	;;
    esac
fi

GS_RES="$RES"
GS_XDIM="$XDIM"
DITHER_OPTS="-m 1"
if [ "$COLOR" != "" ]; then
    GSDEV=-sDEVICE=pamcmyk32
else
    GSDEV=-sDEVICE=pgmraw
fi
if [ "$RES" = "1200x600" ]; then
    DITHER_OPTS="$DITHER_OPTS -p 2"
    GS_RES="600x600"
    GS_XDIM=$(expr $XDIM / 2)
fi

WPT=$(awk "BEGIN{printf \"%.2f\", $GS_XDIM * 72 / 600}")
HPT=$(awk "BEGIN{printf \"%.2f\", $YDIM * 72 / 600}")

DITHER_BIN="$PREFIX/bin/foo2zjs-dither"
DITHER_FILTER="$DITHER_BIN $DITHER_OPTS"
PSTOPSBIN="$PREFIX/bin/foo2zjs-pstops"

if [ "$LPUSER" != "" ]; then
    USER="$LPUSER@$LPHOST"
else
    USER=""
fi

GS="$GSBIN -q -dBATCH -dSAFER --permit-file-read=$SHARE/crd/zjs/ --permit-file-read=/tmp/ -dQUIET -dNOPAUSE -dNOINTERPOLATE"

$PSTOPSBIN $PSTOPS_OPTS | \
$PREFILTER | \
$GS -dDEVICEWIDTHPOINTS=$WPT -dDEVICEHEIGHTPOINTS=$HPT -r$GS_RES $GSDEV $GSOPTS \
    -sOutputFile=- $USECIE_PS $GAMMAFILE -_ | \
$DITHER_FILTER | \
"$PREFIX/bin/foo2zjs" -r$RES -g$DIM -p$PAPER -m$MEDIA -n$COPIES -d$DUPLEX -s$SOURCE \
	    -z$MODEL $COLOR $CLIP_UL $CLIP_LR $CLIP_LOG $SAVETONER -T$DENSITY \
	    -J "$LPJOB" -U "$USER" \
	    $COLOR2MONO $NOPLANES $EXTRAPAD -D$DEBUG

if [ -x /usr/bin/logger ]; then
    logger -t "$BASENAME" -p lpr.info -- \
	"$GSBIN -dDEVICEWIDTHPOINTS=$WPT -dDEVICEHEIGHTPOINTS=$HPT -r$GS_RES $GSDEV $GSOPTS $USECIE_PS $GAMMAFILE"
    logger -t "$BASENAME" -p lpr.info -- \
	"foo2zjs -r$RES -g$DIM -p$PAPER -m$MEDIA -n$COPIES -d$DUPLEX -s$SOURCE -z$MODEL $COLOR $CLIP_UL $CLIP_LR $CLIP_LOG $SAVETONER -T$DENSITY"
fi

if [ $DEBUG -eq 0 ]; then
    [ -f "$ICCTMP.usecie.ps" ] && rm -f "$ICCTMP.usecie.ps"
    [ -n "$TMPFILE" ] && [ -f "$TMPFILE" ] && rm -f "$TMPFILE"
fi

exit 0
